APP_NAME=TelegramEconomyRPG
APP_ENV=production
DEBUG=false

# Telegram
API_ID=12345
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=economy_rpg_bot

# Owner
OWNER_ID=123456789

# Economy Defaults
DEFAULT_BALANCE=500
TAX_RATE=0.05
BANK_INTEREST_RATE=0.02
DAILY_REWARD=100

# Rate Limits
SPAM_LIMIT=3
FLOOD_LIMIT=5
COOLDOWN_SECONDS=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
